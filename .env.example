# P2P Student Micro-Lending Network Configuration
# Database Connection (PostgreSQL / Supabase)
# In Supabase: Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swe_lending

# Auth JWT Secret
JWT_SECRET=vit_student_micro_lending_secret_key_2026_super_secure

# Allowed College Domain
ALLOWED_EMAIL_DOMAIN=@vitstudent.ac.in

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
